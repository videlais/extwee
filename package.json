{
  "name": "extwee",
  "version": "2.3.17",
  "description": "A story compiler tool using Twine-compatible formats",
  "author": "Dan Cox",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./web": "./build/extwee.core.min.js",
    "./web/core": "./build/extwee.core.min.js",
    "./web/twine1html": "./build/extwee.twine1html.min.js",
    "./web/twine2archive": "./build/extwee.twine2archive.min.js",
    "./web/tws": "./build/extwee.tws.min.js"
  },
  "bin": {
    "extwee": "src/extwee.js"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "lint": "eslint \"./src/**/*.js\" --fix",
    "lint:test": "eslint \"./test/**/*.test.js\" --fix",
    "build:cli": "esbuild src/extwee.js --bundle --platform=node --format=cjs --outfile=dist/extwee.cjs",
    "test:bundle": "npm run build:cli && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathPatterns=CLI-bundle",
    "build:web": "webpack",
    "analyze:web": "webpack-bundle-analyzer build/extwee.web.min.js",
    "gen-types": "npx -p typescript tsc src/**/*.js --declaration --allowJs --emitDeclarationOnly --outDir types --skipLibCheck",
    "copy:build": "cp build/*.js docs/build",
    "all": "npm run lint && npm run lint:test && npm run test && npm run build:web && npm run gen-types && npm run copy:build"
  },
  "keywords": [
    "twine",
    "twee",
    "parser",
    "compiler"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "graphemer": "^1.4.0",
    "html-entities": "^2.6.0",
    "node-html-parser": "^7.1.0",
    "pickleparser": "^0.2.1",
    "semver": "^7.8.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@inquirer/prompts": "^8.5.2",
    "@types/node": "^25.9.1",
    "@types/semver": "^7.7.1",
    "babel-loader": "^10.1.1",
    "core-js": "^3.49.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-jsdoc": "^63.0.1",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "regenerator-runtime": "^0.14.1",
    "semgrep": "^0.0.1",
    "shelljs": "^0.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "webpack": "^5.107.2",
    "webpack-bundle-analyzer": "^5.3.0",
    "webpack-cli": "^7.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/videlais/extwee.git"
  },
  "bugs": {
    "url": "https://github.com/videlais/extwee/issues"
  },
  "type": "module",
  "types": "./types/index.d.ts",
  "engines": {
    "node": ">=18.18.0"
  }
}
